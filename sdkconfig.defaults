# CJ-DEBUG task #115: disabled as a pragmatic workaround. Hardware evidence
# this session (raw otadata partition reads via esptool, independent of any
# log capture) shows validate_ota_partition()'s call to
# esp_ota_mark_app_valid_cancel_rollback() never successfully confirms a
# freshly-OTA'd partition -- every real WiFi OTA update lands in
# ESP_OTA_IMG_PENDING_VERIFY and gets silently reverted by the bootloader on
# the next reset, even though the new image itself boots and runs correctly.
# Root cause not found despite four independent diagnostic channels (UART,
# SD, NVS flag, NVS stack-watermark) all showing zero evidence the relevant
# code even executes -- likely needs a JTAG session, tracked as a deferred
# investigation (see memory why2025_ota_confirm_never_executes_task115.md).
#
# Comparison research: Tanmatsu's launcher (Nicolai-Electronics,
# github.com/Nicolai-Electronics/tanmatsu-launcher) never enables this option
# at all and has never needed an equivalent confirm step -- with rollback
# off, esp_ota_set_boot_partition() just sets the boot pointer directly, no
# PENDING_VERIFY state exists, and there is nothing to fail to confirm.
# Disabling it here trades away the "auto-revert on a bad OTA boot" safety
# net for a working OTA update flow.
# CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE is not set
# CONFIG_BOOTLOADER_WDT_ENABLE is not set
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_WARN_WRITE_STRINGS=y
CONFIG_COMPILER_SAVE_RESTORE_LIBCALLS=y
# CONFIG_ANA_CMPR_ISR_HANDLER_IN_IRAM is not set
# CONFIG_GPTIMER_ISR_HANDLER_IN_IRAM is not set
# CONFIG_I2C_MASTER_ISR_HANDLER_IN_IRAM is not set
# CONFIG_MCPWM_ISR_HANDLER_IN_IRAM is not set
# CONFIG_PARLIO_TX_ISR_HANDLER_IN_IRAM is not set
# CONFIG_PARLIO_RX_ISR_HANDLER_IN_IRAM is not set
# CONFIG_RMT_ENCODER_FUNC_IN_IRAM is not set
# CONFIG_RMT_TX_ISR_HANDLER_IN_IRAM is not set
# CONFIG_RMT_RX_ISR_HANDLER_IN_IRAM is not set
CONFIG_SPI_MASTER_IN_IRAM=y
# CONFIG_SPI_SLAVE_ISR_IN_IRAM is not set
# CONFIG_ETH_USE_ESP32_EMAC is not set
# CONFIG_ETH_USE_SPI_ETHERNET is not set
# CONFIG_ESP_EVENT_POST_FROM_ISR is not set
CONFIG_ESP_HTTP_CLIENT_ENABLE_BASIC_AUTH=y
CONFIG_ESP_HTTP_CLIENT_ENABLE_DIGEST_AUTH=y
CONFIG_DMA2D_OPERATION_FUNC_IN_IRAM=y
CONFIG_DMA2D_ISR_IRAM_SAFE=y
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_5=y
CONFIG_LCD_DSI_ISR_IRAM_SAFE=y
# CONFIG_ESP_NETIF_REPORT_DATA_TRAFFIC is not set
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
# CONFIG_SPIRAM_BOOT_INIT is not set
CONFIG_SPIRAM_USE_MEMMAP=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_ESP_SYSTEM_PANIC_REBOOT_DELAY_SECONDS=5
# CONFIG_ESP_SYSTEM_PMP_IDRAM_SPLIT is not set
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# CONFIG_ESP_INT_WDT is not set
# CONFIG_ESP_TASK_WDT_EN is not set
# CONFIG_ESP_DEBUG_OCDAWARE is not set
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_USE_DYN_BUFFERS=y
CONFIG_FREERTOS_THREAD_LOCAL_STORAGE_POINTERS=2
CONFIG_FREERTOS_TIMER_TASK_AFFINITY_CPU0=y
CONFIG_FREERTOS_TASK_NOTIFICATION_ARRAY_ENTRIES=2
CONFIG_FREERTOS_USE_APPLICATION_TASK_TAG=y
CONFIG_FREERTOS_TASK_PRE_DELETION_HOOK=y
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LWIP_LOCAL_HOSTNAME="badgevms"
CONFIG_LWIP_TCPIP_CORE_LOCKING=y
CONFIG_LWIP_TCPIP_CORE_LOCKING_INPUT=y
CONFIG_LWIP_CHECK_THREAD_SAFETY=y
# CONFIG_LWIP_DNS_SUPPORT_MDNS_QUERIES is not set
CONFIG_LWIP_IP4_REASSEMBLY=y
CONFIG_LWIP_IP6_REASSEMBLY=y
CONFIG_LWIP_DHCP_OPTIONS_LEN=69
# CONFIG_LWIP_DHCPS is not set
CONFIG_LWIP_AUTOIP=y
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_IPV6_DHCP6=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_LWIP_DNS_MAX_SERVERS=2
CONFIG_LWIP_DNS_SETSERVER_WITH_NETIF=y
# CONFIG_LWIP_ESP_LWIP_ASSERT is not set
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=y
CONFIG_LIBC_OPTIMIZED_MISALIGNED_ACCESS=y
CONFIG_PTHREAD_DEFAULT_CORE_1=y
CONFIG_SPI_FLASH_SUPPORT_GD_CHIP=y
# CONFIG_SPI_FLASH_ENABLE_ENCRYPTED_READ_WRITE is not set
# CONFIG_WS_TRANSPORT is not set
# CONFIG_ELF_LOADER_LOAD_PSRAM is not set
# CONFIG_ELF_LOADER_ESPIDF_SYMBOLS is not set
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=33
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=32
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=28
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=31
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=30
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=29
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=13

# Root cause of the C6-reflash-triggered crash-loop (see slave_c6_flasher.c's
# C6_POST_RESET_SETTLE_MS comment): ESP-Hosted defaults to unconditionally
# resetting the C6 on every P4 boot right before SDIO bring-up, then
# immediately calling transport_card_init() with only a ~1.5s budget
# (CARD_INIT_TIMEOUT_MS in sdio_drv.c) -- discarding whatever settle time
# flash_slave_c6_if_needed() already gave it and re-triggering the same
# too-soon-after-reset SDIO race. RESET_ONLY_IF_NECESSARY instead tries
# talking to the (already-settled) C6 first and only resets+retries if that
# genuinely fails, avoiding the redundant blind reset entirely.
CONFIG_ESP_HOSTED_SLAVE_RESET_ONLY_IF_NECESSARY=y
# Safety net if the C6 truly is unresponsive: self-restart instead of the
# ESP_ERROR_CHECK abort() this used to hit.
CONFIG_ESP_HOSTED_HOST_RESTART_NO_COMMUNICATION_WITH_SLAVE=y
CONFIG_WIFI_RMT_STATIC_TX_BUFFER=y
# CONFIG_WIFI_RMT_IRAM_OPT is not set
# CONFIG_WIFI_RMT_EXTRA_IRAM_OPT is not set
# CONFIG_WIFI_RMT_RX_IRAM_OPT is not set
# CONFIG_WIFI_RMT_SLP_IRAM_OPT is not set
# CONFIG_WIFI_RMT_SOFTAP_SUPPORT is not set
CONFIG_WIFI_RMT_WAPI_PSK=y
CONFIG_WIFI_RMT_ENT_FREE_DYNAMIC_BUFFER=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# BLE (badgevms/ble.h, see docs/PROJECT_SETUP.md §13.7) — NimBLE host runs on
# the P4, the BT/BLE controller itself lives on the C6 co-processor and is
# reached over the existing esp_hosted SDIO transport, same pattern as WiFi.
# CONFIG_BT_CONTROLLER_DISABLED (not CONFIG_BT_CONTROLLER_ENABLED): the P4 has
# no local BT radio at all, exactly like the vendored
# host_nimble_bleprph_host_only_vhci esp_hosted example this follows.
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_TRANSPORT_UART=n
# NimBLE's own host task runs at (configMAX_PRIORITIES - 4), fixed by the
# vendored nimble port and not something we author ourselves — but pinned to
# core 1 (not the Kconfig default of core 0) so it can never compete with the
# WiFi "hermes" task (prio 5, core 0) or the deploy-listener (prio 3, core 0):
# a prio-6 task on core 0 already starved hermes once this session (see §8c).
CONFIG_BT_NIMBLE_PINNED_TO_CORE_1=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_ESP_HOSTED_ENABLE_BT_NIMBLE=y
CONFIG_ESP_HOSTED_NIMBLE_HCI_VHCI=y

# BadgeLink-over-USB (badgevms/drivers/usb_device.c, docs/design/
# badgelink-usb-port.md) — TinyUSB's vendor class is off by default
# (TINYUSB_VENDOR_COUNT=0); without this, tud_vendor_write()/tud_vendor_read()
# et al. aren't even declared and usb_device.c fails to compile.
# TINYUSB_VENDOR_{RX,TX}_BUFSIZE and _EPSIZE default to 512 on ESP32P4
# already, matching the high-speed endpoint size used in usb_device.c.
CONFIG_TINYUSB_VENDOR_COUNT=1

# USB mass storage (badgevms/drivers/usb_msc.c) -- same composite USB
# device as BadgeLink above, second interface. CFG_TUD_MSC compiles out
# entirely without this, same reasoning as TINYUSB_VENDOR_COUNT. Buffer
# size (CONFIG_TINYUSB_MSC_BUFSIZE) defaults to 8192 on ESP32P4 already.
CONFIG_TINYUSB_MSC_ENABLED=y
